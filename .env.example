# Скопируйте в .env и заполните.

# Секретный ключ Stripe (Dashboard -> Developers -> API keys).
# sk_test_... — тестовый режим, sk_live_... — настоящие платежи.
# Пусто — демо-режим без списания денег.
STRIPE_SECRET_KEY=

# ЛитРес, личный аккаунт: ID приложения и ключ разработчика для API CataLit.
# Выдаёт партнёрский отдел ЛитРес (partners@litres.ru; в заявке укажите, что
# разрабатываете программу для чтения/прослушивания). Пусто — провайдер скрыт.
# Логин и пароль от ЛитРес сюда НЕ пишутся — они вводятся в самом приложении.
LITRES_APP_ID=
LITRES_APP_SECRET=

# ЛитРес, магазинная схема (нужна только продавцам книг ЛитРес по договору):
# ID партнёра и секретный ключ.
# Для проверки интеграции подойдёт тестовый доступ из раздела «Тестовые доступы»
# документации: https://docs.litres.ru/public/205502033.html
# Пусто — провайдер ЛитРес скрыт.
LITRES_PARTNER_ID=
LITRES_SECRET_KEY=
# Магазинная схема: ЛитРес отдаёт цены в рублях. Валюта продажи (usd, eur, rub...) и курс
# (рублей за единицу валюты; пусто — курс ЦБ РФ на сегодня).
LITRES_CURRENCY=usd
LITRES_RUB_RATE=

# Порт и публичный адрес приложения (на него Stripe вернёт покупателя после оплаты).
PORT=3000
BASE_URL=http://localhost:3000
